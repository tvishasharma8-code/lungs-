# ===========================================================================
# unity/ - the Unity project
# ===========================================================================
# Generated / regenerable. Library alone is ~14 GB and is rebuilt from Assets +
# ProjectSettings on first open, so it must never be committed.
/unity/[Ll]ibrary/
/unity/[Tt]emp/
/unity/[Oo]bj/
/unity/[Bb]uild/
/unity/[Bb]uilds/
/unity/[Ll]ogs/
/unity/[Uu]ser[Ss]ettings/
/unity/[Mm]emoryCaptures/
/unity/[Rr]ecordings/
/unity/.utmp/
# VS Code settings Unity writes into its project folder (the repo's own are in /.vscode)
/unity/.vscode/

# IDE project files Unity regenerates
/unity/*.csproj
/unity/*.sln
/unity/*.slnx
/unity/*.unityproj
/unity/*.suo
/unity/*.user
/unity/*.userprefs
/unity/*.pidb
/unity/*.booproj
/unity/*.svd
/unity/*.pdb.meta
/unity/*.mdb.meta

# Asset Store downloads
/unity/[Aa]ssets/AssetStoreTools*

# BioGears writes this at runtime whenever the engine starts (a log, not source)
/unity/Assets/StreamingAssets/BioGears/biogears_unity.log
/unity/Assets/StreamingAssets/BioGears/biogears_unity.log.meta

# Editor-recovery scene snapshots
/unity/Assets/_Recovery/
/unity/Assets/_Recovery.meta

# Per-user XR Simulation state
/unity/Assets/XR/Temp/
/unity/Assets/XR/Temp.meta

# Generated by the Unity performance-testing package on each run
/unity/Assets/Resources/PerformanceTestRun*.json
/unity/Assets/Resources/PerformanceTestRun*.json.meta

# Build leftovers Unity names itself as not-to-ship (IL2CPP backup, Burst symbols)
*_BackUpThisFolder_ButDontShipItWithYourGame/
*_BurstDebugInformation_DoNotShip/

# ===========================================================================
# backend/ - LungVision API (Python)
# ===========================================================================
/backend/.venv/
__pycache__/
*.py[cod]
# Tumor model weights (165 MB, kept on the faster-rcnn-model branch with Git LFS)
/backend/pipeline/weights/*.pth

# ===========================================================================
# frontend/ - LungVision website (Node)
# ===========================================================================
/frontend/node_modules/
/frontend/dist/
*.tsbuildinfo

# ===========================================================================
# tools/ - .NET test projects
# ===========================================================================
/tools/*/bin/
/tools/*/obj/

# ===========================================================================
# Everywhere
# ===========================================================================
# Patient CT data (DICOM) - never commit scans
/patient*/
*.dcm

# Build outputs
*.apk
*.aab
*.unitypackage
*.app

# Crash / profiler dumps
sysinfo.txt
crashlytics-build.properties

# Editors / OS
.vs/
.idea/
.DS_Store
Thumbs.db
