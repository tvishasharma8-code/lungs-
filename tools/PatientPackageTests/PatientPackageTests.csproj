<Project Sdk="Microsoft.NET.Sdk">
  <!-- Reads a real LungVision Patient Package mesh with the same code the VR app uses
       (unity/Assets/LungVR/Scripts/Patient) and checks the coordinate conversion anatomically.
       dotnet run (with argument: folder containing mesh.bin + meta.json) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\unity\Assets\LungVR\Scripts\Patient\LungPackageMesh.cs" />
  </ItemGroup>
</Project>
